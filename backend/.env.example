MONGODB_URI=mongodb://127.0.0.1:27017/raad-dev
# Optional for now: leave unset to run without Redis.
# REDIS_URL=rediss://default:<password>@<host>:<port>
# Required. Signs admin tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<long-random-string-with-at-least-32-characters>
